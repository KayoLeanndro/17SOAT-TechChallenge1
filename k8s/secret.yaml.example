# Modelo para copiar como secret.local.yaml. Nao aplique os placeholders.
apiVersion: v1
kind: Secret
metadata:
  name: mechanics-api-secrets
  labels:
    app: mechanics-api
type: Opaque
stringData:
  # Use a mesma senha informada ao Terraform para criar o RDS.
  SPRING_DATASOURCE_PASSWORD: "SUBSTITUA_PELA_SENHA_DO_RDS"
  # Use uma chave aleatoria propria do ambiente, com pelo menos 32 bytes.
  JWT_SECRET: "SUBSTITUA_POR_UMA_CHAVE_ALEATORIA"
